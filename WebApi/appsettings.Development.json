{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EnableSensitiveDataLogging": true
  },
  "App": {
    "ApiVersion": "1.0.0",
    "LatestClientVersion": "1.2.0",
    "MinSupportedClientVersion": "1.2.0"
  },
  "AllowedHosts": "*",
  "Config": {
    "OriginCors": "https://orionsys.net/",
    "Issuer": "OrionSys",
    "Audience": "OrionSys"
  },
  "BackgroundWorkers": {
    "EspnLiveScore": { "Enabled": false },
    "QuinielaReminder": { "Enabled": false }
  },
  "Push": {
    "Enabled": false
  }
}
